# Environment variables
.env
.env.*
!.env.example

# Go build artifacts
backend/bin/
backend/server
*.exe
*.out
tools/jsonnet-wasm/jsonnet.wasm

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Kubernetes configs (sensitive)
*.kubeconfig
kubeconfigs/
shared_mcp/kubeconfig
shared_mcp/
k8s/secret.yaml       # Generated by install-k8s.sh — never commit real secrets

# Git-sync working copy — may contain a PAT embedded in .git/config, never commit
shared_gitsync/

# Wails desktop build (frontend/dist copied in by `make desktop-build`, Wails build output)
backend/cmd/desktop/frontenddist/*
!backend/cmd/desktop/frontenddist/index.html
backend/cmd/desktop/build/bin/
